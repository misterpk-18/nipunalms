# Copy to backend/.env and adjust
APP_ENV=development
FLASK_APP=app
LOG_LEVEL=DEBUG
# Main database
DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunalms
# Dev replica with staging data, used when APP_ENV=development (flask create-dev-db, flask seed-dev)
DEV_DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunalms-dev
# Tests use DATABASE_URL + "_test" unless this is set
# TEST_DATABASE_URL=postgresql+psycopg://manojtungala@localhost:5432/nipunalms_test
SECRET_KEY=change-me
# The CRM sends this in the X-Service-Key header when it posts events to /api/v1/integrations/crm/events
CRM_SERVICE_KEY=change-me
# Ask Nipuna (optional; without a key the rule-based fallback is used; not read until the student-services slice)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# UPLOAD_DIR=
# The CRM's API base, for handing WhatsApp messages to POST /lms/whatsapp (UX phase U6; unset = WhatsApp not available)
# CRM_BASE_URL=http://127.0.0.1:5050/api/v1
# The address people open the LMS at; certificate PDFs carry it, with a QR code, for verification (UX phase U10; unset = no QR code)
# PUBLIC_BASE_URL=https://lms.example.com

# Google Workspace (docs/GOOGLE_WORKSPACE.md). Leave empty until the Workspace admin has set up the service account.
# The Workspace domain the delegation applies to, e.g. example.org
GOOGLE_WORKSPACE_DOMAIN=
# A real mailbox in that domain the service account acts as when no branch mailbox applies
GOOGLE_DELEGATED_ADMIN=
# The service-account key. Development: a git-ignored file. Production: the Secret Manager resource, projects/<id>/secrets/<name>/versions/latest
GOOGLE_SA_KEY_FILE=secrets/google-service-account.json
GOOGLE_SA_SECRET_NAME=
# Who LMS emails come from unless a branch sets its own. A sample no-reply address until the real one is given; it must be a real mailbox in the domain
GOOGLE_EMAIL_SENDER=no-reply@nipunatechnologies.com
# Only when that address is a Google alias of a real user: that user's mailbox (the login Google accepts), and the name shown in From
GOOGLE_EMAIL_SENDER_MAILBOX=
GOOGLE_EMAIL_SENDER_NAME=
# Seconds to wait for one Google call
GOOGLE_REQUEST_TIMEOUT=15
